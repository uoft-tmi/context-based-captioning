"""
proof of concept: whisper rescoring with shallow fusion
demonstrates: whisper transcription → confidence detection → phonetic matching → lm rescoring
"""

import torch
import whisper
from transformers import GPT2LMHeadModel, GPT2Tokenizer
from metaphone import doublemetaphone
import jellyfish
import numpy as np

# ============================================
# setup
# ============================================
print("loading models...")

# load whisper mini
whisper_model = whisper.load_model("tiny")
print("✓ whisper loaded")

# load gpt-2 for rescoring
device = "cuda" if torch.cuda.is_available() else "cpu"
lm_tokenizer = GPT2Tokenizer.from_pretrained("gpt2")
lm_model = GPT2LMHeadModel.from_pretrained("gpt2").to(device)
lm_model.eval()
print(f"✓ gpt-2 loaded on {device}")

# ============================================
# configuration
# ============================================
CONFIDENCE_THRESHOLD = 0.7  # rescore words below this confidence
PHONETIC_THRESHOLD = 0.50   # minimum phonetic similarity
LAMBDA = 0.4               # weight for lm in shallow fusion
MIN_IMPROVEMENT = 0.1      # minimum score improvement to replace

# hot words list (domain vocabulary)
HOT_WORDS = [
    "eigenvalue", "eigenvector", "matrix", "determinant",
    "gaussian", "probability", "statistics", "variance",
    "mitochondria", "photosynthesis", "ribosome",
    "derivative", "integral", "theorem", "polynomial",
    "algorithm", "recursion", "iteration", "complexity"
]

print(f"✓ loaded {len(HOT_WORDS)} hot words\n")

# ============================================
# helper functions
# ============================================

def get_phonetic_similarity(word1, word2):
    """calculate phonetic similarity between two words (0-1 scale)"""
    code1 = doublemetaphone(word1.lower())[0]
    code2 = doublemetaphone(word2.lower())[0]
    
    if not code1 or not code2:
        return 0.0
    
    if code1 == code2:
        return 1.0
    
    max_len = max(len(code1), len(code2))
    if max_len == 0:
        return 0.0
    
    edit_dist = jellyfish.levenshtein_distance(code1, code2)
    similarity = 1 - (edit_dist / max_len)
    return similarity

def find_phonetic_matches(word, hot_words, threshold=PHONETIC_THRESHOLD):
    """find hot words that sound similar to the given word"""
    matches = []
    for hot_word in hot_words:
        similarity = get_phonetic_similarity(word, hot_word)
        if similarity >= threshold:
            matches.append((hot_word, similarity))
    
    # sort by similarity (best first)
    matches.sort(key=lambda x: x[1], reverse=True)
    return matches

def score_with_lm(text):
    """get log probability of text from language model"""
    tokens = lm_tokenizer.encode(text, return_tensors="pt").to(device)
    
    with torch.no_grad():
        outputs = lm_model(tokens, labels=tokens)
        # convert loss to log probability
        log_prob = -outputs.loss.item()
    
    return log_prob

def rescore_word_in_context(word, confidence, context_before, context_after, hot_words):
    """
    rescore a single word using shallow fusion
    returns: (best_word, explanation_dict)
    """
    
    # step 1: check if confidence is low enough to rescore
    if confidence >= CONFIDENCE_THRESHOLD:
        return word, {
            "action": "kept_original",
            "reason": f"confidence {confidence:.2f} above threshold {CONFIDENCE_THRESHOLD}"
        }
    
    # step 2: find phonetically similar hot words
    candidates = find_phonetic_matches(word, hot_words)
    
    if not candidates:
        return word, {
            "action": "kept_original",
            "reason": f"no phonetically similar hot words (threshold {PHONETIC_THRESHOLD})",
            "word_phonetic_code": doublemetaphone(word)[0]
        }
    
    # step 3: score original and candidates with lm
    original_context = f"{context_before} {word} {context_after}"
    original_lm_score = score_with_lm(original_context)
    
    # shallow fusion: combine whisper confidence + lm score
    original_combined = np.log(max(confidence, 0.01)) + LAMBDA * original_lm_score
    
    # score each candidate
    candidate_scores = {}
    for candidate, phon_sim in candidates:
        candidate_context = f"{context_before} {candidate} {context_after}"
        candidate_lm_score = score_with_lm(candidate_context)
        
        # shallow fusion formula
        combined_score = np.log(max(confidence, 0.01)) + LAMBDA * candidate_lm_score
        
        candidate_scores[candidate] = {
            "phonetic_similarity": phon_sim,
            "lm_score": candidate_lm_score,
            "combined_score": combined_score
        }
    
    # step 4: find best candidate
    best_candidate = max(candidate_scores.keys(), 
                        key=lambda c: candidate_scores[c]["combined_score"])
    best_score = candidate_scores[best_candidate]["combined_score"]
    
    # step 5: decide whether to replace
    improvement = best_score - original_combined
    
    if improvement > MIN_IMPROVEMENT:
        return best_candidate, {
            "action": "replaced",
            "original": word,
            "replacement": best_candidate,
            "whisper_confidence": confidence,
            "original_combined_score": original_combined,
            "best_combined_score": best_score,
            "improvement": improvement,
            "candidates_considered": len(candidates),
            "top_candidates": candidate_scores
        }
    else:
        return word, {
            "action": "kept_original",
            "reason": f"improvement {improvement:.2f} below threshold {MIN_IMPROVEMENT}",
            "best_alternative": best_candidate,
            "best_alternative_improvement": improvement,
            "candidates_considered": len(candidates)
        }

# ============================================
# main rescoring pipeline
# ============================================

def rescore_transcript(transcript_result, hot_words):
    """
    rescore whisper transcript using shallow fusion
    
    args:
        transcript_result: whisper transcription result with word timestamps
        hot_words: list of domain-specific vocabulary
    
    returns:
        rescored_text, detailed_log
    """
    
    words = []
    log = []
    
    # extract words with confidence scores
    for segment in transcript_result["segments"]:
        if "words" not in segment:
            continue
            
        for word_info in segment["words"]:
            word = word_info["word"].strip()
            confidence = word_info.get("probability", 1.0)
            
            words.append({
                "word": word,
                "confidence": confidence,
                "start": word_info.get("start", 0),
                "end": word_info.get("end", 0)
            })
    
    # rescore each word with context
    rescored_words = []
    
    for i, word_data in enumerate(words):
        word = word_data["word"]
        confidence = word_data["confidence"]
        
        # get context (5 words before and after)
        context_before = " ".join([w["word"] for w in words[max(0, i-5):i]])
        context_after = " ".join([w["word"] for w in words[i+1:min(len(words), i+6)]])
        
        # rescore
        best_word, explanation = rescore_word_in_context(
            word, confidence, context_before, context_after, hot_words
        )
        
        rescored_words.append(best_word)
        
        # always log low-confidence words (whether replaced or not)
        if confidence < CONFIDENCE_THRESHOLD:
            log.append({
                "position": i,
                "word_data": word_data,
                "context_before": context_before,
                "context_after": context_after,
                "explanation": explanation
            })
    
    rescored_text = " ".join(rescored_words)
    
    return rescored_text, log

