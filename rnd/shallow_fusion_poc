# ============================================
# run with real audio (optional)
# ============================================

def transcribe_and_rescore(audio_path, hot_words=HOT_WORDS):
    """
    transcribe audio file and apply rescoring
    
    args:
        audio_path: path to audio file
        hot_words: domain vocabulary list
    
    returns:
        original_text, rescored_text, log
    """
    
    print(f"transcribing audio: {audio_path}")
    
    # transcribe with word-level timestamps
    result = whisper_model.transcribe(
        audio_path,
        word_timestamps=True,
        verbose=False
    )
    
    original_text = result["text"]
    print(f"\noriginal: {original_text}")
    
    # rescore
    rescored_text, log = rescore_transcript(result, hot_words)
    print(f"rescored: {rescored_text}")
    
    # show changes
    if log:
        print(f"\n{len(log)} words analyzed:")
        replaced = [e for e in log if e["explanation"]["action"] == "replaced"]
        if replaced:
            print(f"{len(replaced)} words rescored:")
            for entry in replaced:
                exp = entry["explanation"]
                print(f"  '{exp['original']}' → '{exp['replacement']}'")
        else:
            print("no words met replacement criteria")
    else:
        print("\nno low-confidence words found")
    
    return original_text, rescored_text, log

